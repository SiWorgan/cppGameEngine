{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make build",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the whole project via the Makefile"
        },
        {
            "label": "make run",
            "type": "shell",
            "command": "make run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "make build",
            "problemMatcher": [],
            "detail": "Build (if needed) and run the game engine"
        },
        {
            "label": "make clean",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Remove the built binary"
        }
    ]
}
